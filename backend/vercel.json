{
  "version": 2,
  "crons": [
    {
      "path": "/api/ops/reconcile-library?limit=500",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
